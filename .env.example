# Bharat Translator - Environment Variables Configuration
# Copy this file to .env and fill in any API keys you wish to use.
# If left blank, the app will automatically use the built-in free cloud fallback & offline phrasebook.

# Server Port
PORT=3000

# 1. Govt. of India Bhashini ULCA API (Recommended for Indian Languages)
# Sign up at: https://bhashini.gov.in/en/
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=

# 2. Google Cloud Translation API
# Get key at: https://console.cloud.google.com/apis/credentials
GOOGLE_TRANSLATE_API_KEY=

# 3. Azure Cognitive Services Translator
# Get key at: https://portal.azure.com
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=centralindia

# 4. Google Gemini API (High-quality contextual translation)
# Get key at: https://aistudio.google.com/
GEMINI_API_KEY=
